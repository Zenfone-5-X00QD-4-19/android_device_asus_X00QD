soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel"
    ],
}

mkdir {
    name: "vendor_ADF_mountpoint",
    dir: "ADF",
    vendor: true,
}

mkdir {
    name: "vendor_APD_mountpoint",
    dir: "APD",
    vendor: true,
}

mkdir {
    name: "vendor_asdf_mountpoint",
    dir: "asdf",
    vendor: true,
}

mkdir {
    name: "vendor_factory_mountpoint",
    dir: "factory",
    vendor: true,
}

mkdir {
    name: "vendor_asusfw_mountpoint",
    dir: "asusfw",
    vendor: true,
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}
