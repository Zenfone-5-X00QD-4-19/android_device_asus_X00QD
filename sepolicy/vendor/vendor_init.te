typeattribute vendor_init data_between_core_and_vendor_violators;

get_prop(vendor_init, customize_prop)
set_prop(vendor_init, customize_prop)

allow init adsprpcd_file:file mounton;
allow vendor_init proc:file w_file_perms;

# Allow vendor_init to set persist_camera_prop
set_prop(vendor_init, vendor_persist_camera_prop)
allow vendor_init vendor_camera_prop:property_service { set };

allow vendor_init device:file { create write };
allow vendor_init vendor_alarm_boot_prop:property_service { set };

# Allow vendor_init to set vendor_camera_prop
get_prop(vendor_init, camera_prop)
set_prop(vendor_init, camera_prop)
get_prop(vendor_init, vendor_camera_prop)
set_prop(vendor_init, vendor_camera_prop)

get_prop(vendor_init, hal_audio_prop)
set_prop(vendor_init, hal_audio_prop)

allow vendor_init factory_file:filesystem getattr;

allow vendor_init proc:file write;
allow vendor_init vendor_file : dir {setattr};
