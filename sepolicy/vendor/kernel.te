# Battery
allow kernel log_file:dir { search open };
allow kernel log_file:lnk_file read;
allow kernel log_file:dir rw_dir_perms;
allow kernel log_file:file create_file_perms;
allow kernel demoapp_file:file { open read write create setattr };
allow kernel demoapp_file:dir { search open read write add_name setattr };
allow kernel block_device:dir { search open read write setattr };
allow kernel block_device:file { open read write setattr };
allow kernel batterystats_file:file create_file_perms;
allow kernel batterystats_file:file { open read write setattr };
allow kernel batterystats_file:blk_file { open read getattr setattr };
allow kernel unlabeled:file { open read write };

# Factory files
allow kernel factory_file:dir r_dir_perms;
allow kernel factory_file:{file lnk_file} rw_file_perms;

allow kernel self:qipcrtr_socket create;

allow kernel demoapp_file:{file lnk_file} rw_file_perms;
allow kernel kernel:capability { kill };
