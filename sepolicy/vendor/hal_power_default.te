# Allow powerhal to read/write to dt2w node
allow hal_power_default proc_touchpanel:dir r_dir_perms;
allow hal_power_default proc_touchpanel:file rw_file_perms;

# To do powerhint on nodes defined in powerhint.json
allow hal_power_default device_latency:chr_file rw_file_perms;
allow hal_power_default sysfs:file { write };
allow hal_power_default device:file { write open };
allow hal_power_default sysfs:file { open write };
allow hal_power_default proc:{ file lnk_file } rw_file_perms;
allow hal_power_default proc:file { write };
